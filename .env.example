# Set the Gemini API key in the dashboard; it is saved in the OS credential store.
# For headless use, inject GEMINI_API_KEY into the process environment, not this file.
# Get a key in Google AI Studio: https://aistudio.google.com/apikey

# Default Gemini model
GEMINI_MODEL=gemini-2.5-flash

# Local server port
PORT=8000
