# Ключ Gemini API для автоматической расшифровки сокращений Costco и категоризации новых Item #
# Получить ключ можно в Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Модель Gemini по умолчанию
GEMINI_MODEL=gemini-2.5-flash

# Порт локального сервера
PORT=8000
